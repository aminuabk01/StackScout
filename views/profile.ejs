<%- include('partials/header', { title: user.username + ' — StackScout' }) %>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2><%= user.username %></h2>
      <form method="POST" action="/logout" style="margin: 0;">
        <button type="submit" class="btn btn-ghost" style="cursor: pointer;">Log out</button>
      </form>
    </div>

    <p style="color: var(--text-muted); margin-bottom: 32px;"><%= user.email %></p>

    <% if (user.isAdmin) { %>
      <a href="/admin" class="btn btn-primary" style="margin-bottom: 32px; display:inline-block;">Open review dashboard</a>
    <% } %>

    <div class="section-header">
      <h2 style="font-size: 18px;">Your submitted opportunities</h2>
      <a href="/submit" class="btn btn-primary">Post an opportunity</a>
    </div>

    <% if (submissions.length === 0) { %>
      <div class="empty-state">You haven't submitted any opportunities yet.</div>
    <% } else { %>
      <div class="opp-list">
        <% submissions.forEach(function(o) { %>
          <div class="opp-row">
            <div class="opp-main">
              <span class="opp-title"><%= o.title %></span>
              <span class="opp-meta"><%= o.projectName %></span>
            </div>
            <span class="review-status review-<%= o.reviewStatus %>"><%= o.reviewStatus %></span>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
