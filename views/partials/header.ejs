<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'StackScout' %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/img/logo.png">
  <script>
    (function () {
      var saved = localStorage.getItem('stackscout-theme');
      var theme = saved || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
</head>
<body>
  <nav class="nav">
    <div class="container nav-inner">
      <a href="/" class="logo"><img src="/img/logo.png" alt="StackScout" class="logo-mark"> StackScout</a>
      <div class="nav-links" id="navLinks">
        <a href="/#projects">Projects</a>
        <a href="/#opportunities">Opportunities</a>
        <a href="/submit">Post an opportunity</a>
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/profile">Profile</a>
          <form method="POST" action="/logout" class="nav-logout-form">
            <button type="submit" class="nav-logout-btn">Log out</button>
          </form>
        <% } %>
      </div>
      <div class="nav-actions">
        <button class="theme-toggle" id="themeToggle" aria-label="Toggle light/dark mode">
          <span class="theme-icon-dark">&#9789;</span>
          <span class="theme-icon-light">&#9728;</span>
        </button>
        <button class="nav-toggle" id="navToggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="navLinks">
          <span></span><span></span><span></span>
        </button>
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/profile" class="profile-badge" aria-label="Your profile">
            <span class="profile-avatar"><%= user.username.charAt(0).toUpperCase() %></span>
            <span class="profile-name"><%= user.username %></span>
          </a>
        <% } else { %>
          <a href="/login" class="btn btn-primary">Sign in</a>
        <% } %>
      </div>
    </div>
  </nav>
  <script src="/js/main.js" defer></script>
